extends Node

## AudioManager — Centralised audio control for TowerTock
## Plays all SFX and manages background music.

const BUS_MASTER := "Master"
const BUS_MUSIC  := "Music"
const BUS_SFX    := "SFX"

## Sound effect paths — WAV files generated by GenerateAudio.ps1
const SFX_PATHS := {
	"button_click":     "res://assets/audio/sfx_button_click.wav",
	"building_release": "res://assets/audio/sfx_release.wav",
	"building_land":    "res://assets/audio/sfx_land.wav",
	"perfect":          "res://assets/audio/sfx_perfect.wav",
	"combo":            "res://assets/audio/sfx_combo.wav",
	"miss":             "res://assets/audio/sfx_miss.wav",
	"game_over":        "res://assets/audio/sfx_game_over.wav",
	"revive":           "res://assets/audio/sfx_revive.wav",
}

const MUSIC_PATH := "res://assets/audio/music_main.wav"

var _music_player: AudioStreamPlayer
var _sfx_players: Dictionary = {}

func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_setup_buses()
	_create_music_player()
	_create_sfx_players()
	_apply_saved_prefs()

func _setup_buses() -> void:
	# Ensure SFX and Music buses exist
	if AudioServer.get_bus_index(BUS_MUSIC) == -1:
		AudioServer.add_bus()
		AudioServer.set_bus_name(AudioServer.get_bus_count() - 1, BUS_MUSIC)
		AudioServer.set_bus_send(AudioServer.get_bus_index(BUS_MUSIC), BUS_MASTER)
	if AudioServer.get_bus_index(BUS_SFX) == -1:
		AudioServer.add_bus()
		AudioServer.set_bus_name(AudioServer.get_bus_count() - 1, BUS_SFX)
		AudioServer.set_bus_send(AudioServer.get_bus_index(BUS_SFX), BUS_MASTER)

func _create_music_player() -> void:
	_music_player = AudioStreamPlayer.new()
	_music_player.bus = BUS_MUSIC
	_music_player.volume_db = linear_to_db(SaveManager.get_music_volume())
	add_child(_music_player)
	if ResourceLoader.exists(MUSIC_PATH):
		_music_player.stream = load(MUSIC_PATH)
		_music_player.autoplay = false

func _create_sfx_players() -> void:
	for key in SFX_PATHS.keys():
		var player := AudioStreamPlayer.new()
		player.bus = BUS_SFX
		player.volume_db = linear_to_db(SaveManager.get_sfx_volume())
		add_child(player)
		if ResourceLoader.exists(SFX_PATHS[key]):
			player.stream = load(SFX_PATHS[key])
		_sfx_players[key] = player

func _apply_saved_prefs() -> void:
	set_music_enabled(SaveManager.get_music_enabled())
	set_sfx_enabled(SaveManager.get_sfx_enabled())

## Music controls
func play_music() -> void:
	if not SaveManager.get_music_enabled():
		return
	if _music_player.stream and not _music_player.playing:
		_music_player.play()

func stop_music() -> void:
	_music_player.stop()

func set_music_enabled(enabled: bool) -> void:
	SaveManager.set_music_enabled(enabled)
	if enabled:
		play_music()
	else:
		stop_music()

func set_sfx_enabled(enabled: bool) -> void:
	SaveManager.set_sfx_enabled(enabled)
	var bus_idx := AudioServer.get_bus_index(BUS_SFX)
	if bus_idx >= 0:
		AudioServer.set_bus_mute(bus_idx, not enabled)

func set_music_volume(vol: float) -> void:
	SaveManager.set_music_volume(vol)
	_music_player.volume_db = linear_to_db(vol)

func set_sfx_volume(vol: float) -> void:
	SaveManager.set_sfx_volume(vol)
	for player: AudioStreamPlayer in _sfx_players.values():
		player.volume_db = linear_to_db(vol)

## Play a named SFX
func play_sfx(name: String) -> void:
	if not SaveManager.get_sfx_enabled():
		return
	if _sfx_players.has(name):
		var player: AudioStreamPlayer = _sfx_players[name]
		if player.stream:
			player.play()
	else:
		push_warning("AudioManager: Unknown SFX '%s'" % name)

## Pause / resume all audio (e.g. when app backgrounds)
func pause_all() -> void:
	_music_player.stream_paused = true

func resume_all() -> void:
	if SaveManager.get_music_enabled():
		_music_player.stream_paused = false
